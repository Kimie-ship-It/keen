# Generate an unpredictable management token with npm run setup:local.
ADMIN_TOKEN=
# Optional Feishu custom bot configuration. Never commit real values.
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=
# Collector request limits.
COLLECT_TIMEOUT_MS=15000
COLLECT_RETRIES=3
COLLECT_INTERVAL_MS=3600000
# Number of daily database backups to keep outside the project folder.
BACKUP_RETENTION_COUNT=14
# Optional hosted PostgreSQL connection. Keep this only in .env.local or the hosting secret store.
SUPABASE_DB_URL=
# Website reads and reviews: sqlite (default) or supabase. Never silently falls back.
CAMPUS_JOBS_STORAGE=sqlite
# Verify the server certificate by default. Optional PEM CA, with escaped newlines.
SUPABASE_SSL_CA=
# Local troubleshooting only; leave 0 for public deployment.
SUPABASE_SSL_INSECURE=0
